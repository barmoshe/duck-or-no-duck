static var _cache := {}


static func tex(id: String) -> Texture2D:
	if not _cache.has(id):
		var rows: Array = ALL.get(id, ALL["headbutt"])
		var img := Image.create_empty(13, 12, false, Image.FORMAT_RGBA8)
		for y in rows.size():
			var row := String(rows[y])
			for x in mini(13, row.length()):
				var ch := row[x]
				if KEY.has(ch):
					img.set_pixel(x, y, Pal.e(String(KEY[ch])))
		_cache[id] = ImageTexture.create_from_image(img)
	return _cache[id]
